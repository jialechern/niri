// 此配置文件采用 KDL 格式：https://kdl.dev
// "/-" 注释掉后面的节点
// 完整配置说明请查阅维基：
// https://yalter.github.io/niri/Configuration:-Introduction

// 环境变量配置
environment {
    // 应用程序语言配置
    LC_MESSAGES "zh_CN.UTF-8"
    LANG "zh_CN.UTF-8"
    // 配置 Electron 应用优先使用 Wayland
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    ELECTRON_ENABLE_FEATURES "WaylandWindowDecorations"
    // fcitx5 配置
    XMODIFIERS "@im=fcitx"
    // qt 软件样式配置
    QT_QPA_PLATFORMTHEME "qt6ct"
    // gtk 主题设置
    GTK_THEME "Nordic:dark"
    // 默认终端模拟器配置
    TERMINAL "ghostty"
}

// 输入设备配置
// 完整选项列表请查阅维基：
// https://yalter.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // 可设置规则、模型、布局、变体和选项
            // 更多信息请参阅 xkeyboard-config(7)

            // 例如：
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // 如果此部分为空，niri 将从 org.freedesktop.locale1 获取 xkb 设置
            // 您可以使用 localectl set-x11-keymap 控制这些设置
        }

        // 启动时启用数字锁定键，省略此设置则禁用
        numlock
    }

    // 以下部分包含 libinput 设置
    // 省略设置将禁用它们，或保留其默认值
    // 此处所有注释掉的设置均为示例，并非默认值
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 取消注释此行可使鼠标跳转到新聚焦窗口的中心
    // warp-mouse-to-focus

    // 当鼠标移入时自动聚焦窗口和输出
    // 设置 max-scroll-amount="0%" 使其仅对已完全在屏幕上的窗口生效
    focus-follows-mouse max-scroll-amount="0%"
}

// 您可以通过输出名称配置输出设备，名称可通过在 niri 实例中运行 `niri msg outputs` 找到
// 内置笔记本电脑显示器通常称为 "eDP-1"
// 更多信息请查阅维基：
// https://yalter.github.io/niri/Configuration:-Outputs
// 记得通过删除 "/-" 取消注释节点！

output "eDP-1" {
    mode "1920x1080@60.056"
    scale 1.0
    position x=0 y=0
    focus-at-startup
}

/-output "eDP-1" {
    // 取消注释此行以禁用此输出
    // off

    // 输出的分辨率和可选刷新率
    // 格式为 "<宽度>x<高度>" 或 "<宽度>x<高度>@<刷新率>"
    // 如果省略刷新率，niri 将为此分辨率选择最高刷新率
    // 如果完全省略模式或模式无效，niri 将自动选择一个
    // 在 niri 实例中运行 `niri msg outputs` 以列出所有输出及其模式
    mode "1920x1080@120.030"

    // 可使用整数或小数缩放，例如使用 1.5 表示 150% 缩放
    scale 2

    // 变换允许逆时针旋转输出，有效值为：
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 and flipped-270.
    transform "normal"

    // 输出在全局坐标空间中的位置
    // 这会影响方向性显示器操作，如 "focus-monitor-left" 和光标移动
    // 光标只能在直接相邻的输出之间移动
    // 定位时必须考虑输出缩放和旋转：
    // 输出大小以逻辑（或缩放后的）像素为单位
    // 例如，3840×2160 输出，缩放 2.0 将具有 1920×1080 的逻辑大小，
    // 因此要在其右侧直接放置另一个输出，将其 x 设置为 1920
    // 如果未设置位置或导致重叠，输出将自动放置
    position x=1280 y=0
}

// 影响窗口定位和大小的设置
// 更多信息请查阅维基：
// https://yalter.github.io/niri/Configuration:-Layout
layout {
    // 以逻辑像素为单位设置窗口周围的间隙
    // 设置窗口间距
    gaps 16

    // 何时在更改焦点时居中列，选项有：
    // - "never"：默认行为，聚焦屏幕外列将保持在屏幕左侧或右侧边缘
    // - "always"：聚焦的列将始终居中
    // - "on-overflow"：如果列与先前聚焦的列一起无法容纳，聚焦时将居中该列
    center-focused-column "never"

    // 可自定义 "switch-preset-column-width" (Mod+R) 切换的宽度
    preset-column-widths {
        // 比例将宽度设置为输出宽度的分数，考虑间隙
        // 例如，您可以在输出上完美容纳四个 "proportion 0.25" 大小的窗口
        // 默认预设宽度为输出的 1/3、1/2 和 2/3
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // 固定值以逻辑像素精确设置宽度
        // fixed 1920
    }

    // 也可自定义 "switch-preset-window-height" (Mod+Shift+R) 切换的高度
    // preset-window-heights { }

    // 可更改新窗口的默认宽度
    // 窗口打开时的默认宽度
    default-column-width { proportion 0.5; }
    // 如果保留空括号，窗口将自行决定其初始宽度
    // default-column-width {}

    // 默认情况下，焦点环和边框作为实心背景矩形在窗口后面渲染
    // 也就是说，它们将通过半透明窗口显示
    // 这是因为使用客户端装饰的窗口可以具有任意形状
    //
    // 如果不喜欢这样，应取消注释下面的 `prefer-no-csd`
    // niri 将在同意省略其客户端装饰的窗口*周围*绘制焦点环和边框
    //
    // 或者，可以使用名为 `draw-border-with-background` 的窗口规则覆盖此设置

    // 可更改焦点环的外观
    focus-ring {
        // 取消注释此行以禁用焦点环
        // off

        // 环从窗口向外延伸的逻辑像素数
        width 3

        // 颜色可通过多种方式设置：
        // - CSS 命名颜色："red"
        // - RGB 十六进制："#rgb"、"#rgba"、"#rrggbb"、"#rrggbbaa"
        // - CSS 样式表示法："rgb(255, 127, 0)"、rgba()、hsl() 等

        // 活动显示器上环的颜色
        active-color "#00000000"

        // 非活动显示器上环的颜色
        // 焦点环仅围绕活动窗口绘制，因此唯一可以看到其非活动颜色的地方是其他显示器
        inactive-color "#00000000"

        // 也可使用渐变。渐变优先于纯色
        // 渐变渲染方式与 CSS linear-gradient(angle, from, to) 相同
        // 角度与 linear-gradient 相同，可选，默认为 180（从上到下渐变）
        // 可使用网络上的任何 CSS linear-gradient 工具设置这些
        // 也支持更改颜色空间，更多信息请查阅维基
        //
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45

        // 也可相对于工作区的整个视图为渐变着色，而不仅仅是窗口本身
        // 为此，设置 relative-to="workspace-view"
        //
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 也可添加边框。它与焦点环类似，但始终可见
    border {
        // 设置与焦点环相同
        // 如果启用边框，可能希望禁用焦点环
        off

        width 4
        active-color "#ffc87f"
        inactive-color "#505050"

        // 请求注意的窗口周围边框的颜色
        urgent-color "#9b0000"

        // 渐变可使用几种不同的插值颜色空间
        // 例如，这是通过 in="oklch longer hue" 实现的柔和彩虹渐变
        //
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"

        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 可为窗口启用阴影
    shadow {
        // 取消注释下一行以启用阴影
        on

        // 默认情况下，阴影仅在其窗口周围绘制，而不在其后面绘制
        // 取消注释此设置以使阴影在其窗口后面绘制
        //
        // 注意：niri 无法知道 CSD 窗口圆角半径
        // 它必须假设窗口具有直角，导致 CSD 圆角内部出现阴影伪影
        // 此设置修复了这些伪影
        //
        // 但是，您可能希望设置 prefer-no-csd 和/或 geometry-corner-radius
        // 然后，niri 将知道圆角半径并正确绘制阴影，而无需在窗口后面绘制
        // 如果窗口绘制了任何客户端阴影，这些设置也会移除它们
        //
        // draw-behind-window true

        // 可更改阴影外观。以下值以逻辑像素为单位，与 CSS box-shadow 属性匹配

        // 柔和度控制阴影模糊半径
        softness 7

        // 扩展扩大阴影
        spread 5

        // 偏移相对于窗口移动阴影
        offset x=0 y=5

        // 也可更改阴影颜色和不透明度
        color "#0007"
    }

    // 支柱缩小窗口占用的区域，类似于层外壳面板
    // 可将其视为一种外部间隙。以逻辑像素为单位设置
    // 左侧和右侧支柱将导致侧面的下一个窗口始终可见
    // 顶部和底部支柱将简单地在层外壳面板和常规间隙占用的区域之外添加外部间隙
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// 添加类似此行以在启动时生成进程
// 注意：作为会话运行 niri 支持 xdg-desktop-autostart，使用起来可能更方便
// 更多生成示例请参阅下面的 binds 部分

// 此行启动 waybar，这是 Wayland 合成器常用的状态栏
spawn-at-startup "waybar"

// -------------------- 桌面环境设置 --------------------
spawn-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gtk"
// 深色模式
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "color-scheme" "prefer-dark"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "icon-theme" "'Papirus-Dark'"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "gtk-theme" "Nordic"
// 终端模拟器
spawn-at-startup "xdg-mime" "default" "ghostty.desktop" "x-scheme-handler/terminal"
// 文件管理器
spawn-at-startup "xdg-settings" "set" "default-web-browser" "firefox.desktop"
spawn-at-startup "xdg-mime" "default" "thunar.desktop" "inode/directory"
// 默认图片启动器
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/jpeg"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/png"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/gif"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/webp"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/bmp"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/tiff"
spawn-at-startup "xdg-mime" "default" "org.gnome.Loupe.desktop" "image/svg+xml"
// 默认电子书查看器
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "application/pdf"
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "application/epub+zip"
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "application/x-filler"
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "image/vnd.djvu"
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "application/x-cbr"
spawn-at-startup "xdg-mime" "default" "org.pwmt.zathura.desktop" "application/x-cbz"
// 加载配置
spawn-at-startup "dbus-update-activation-environment" "--all"
spawn-at-startup "/usr/lib/xdg-desktop-portal-gtk" "-r"
// -------------------- 桌面环境设置 --------------------

// 护眼模式配置
spawn-at-startup "wlsunset" "-l" "40.0" "-L" "116.0"
// 自启动消息通知
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "mako"
// 自启动输入法
spawn-at-startup "fcitx5"
// 自启动锁屏
spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
// 剪贴板管理器
spawn-at-startup "wl-clip-persist" "--clipboard" "regular"
// 壁纸工具设置
spawn-at-startup "swww-daemon"

// 要运行 shell 命令（包含变量、管道等），请使用 spawn-sh-at-startup：
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // 取消注释此行以禁用启动时的"重要快捷键"弹出窗口
    skip-at-startup
}

// 取消注释此行以请求客户端尽可能省略其客户端装饰
// 如果客户端特别请求 CSD，将尊重该请求
// 此外，客户端将被告知它们是平铺的，移除一些客户端圆角
// 此选项还将修复某些半透明窗口后面的边框/焦点环绘制
// 启用或禁用此选项后，需要重新启动应用程序才能生效

// 去除窗口的标题栏
prefer-no-csd

// 可更改屏幕截图的保存路径
// 开头的 ~ 将扩展为主目录
// 路径使用 strftime(3) 格式化，为您提供屏幕截图的日期和时间
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 也可将其设置为 null 以禁用将屏幕截图保存到磁盘
// screenshot-path null

// 光标主题
cursor {
    // 主题
    xcursor-theme "breeze_cursors"
    // 大小
    xcursor-size 27
    // 闲置时隐藏光标
    hide-after-inactive-ms 15000
}

// 动画设置
// 维基解释了如何配置单个动画：
// https://yalter.github.io/niri/Configuration:-Animations
animations {
    // 取消注释以关闭所有动画
    // off

    // 按此系数减慢所有动画。低于 1 的值将加快动画速度
    // slowdown 3.0
}

// 窗口规则允许您调整单个窗口的行为
// 更多信息请查阅维基：
// https://yalter.github.io/niri/Configuration:-Window-Rules

// 通过设置空默认列宽度解决 WezTerm 的初始配置错误
window-rule {
    // 此正则表达式特意尽可能具体，因为这是默认配置，我们不希望出现误报
    // 如果愿意，可以只使用 app-id="wezterm"
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// 默认以浮动模式打开 Firefox 画中画播放器
window-rule {
    // 此 app-id 正则表达式适用于两者：
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// 示例：从屏幕捕获中屏蔽两个密码管理器
// (此示例规则以 "/-" 开头注释掉)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // 如果希望它们在第三方屏幕截图工具中可见，请改用此设置
    // block-out-from "screencast"
}

// 为所有窗口启用圆角
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.95
    draw-border-with-background true
}

binds {
    // 按键由用 + 号分隔的修饰符组成，最后是 XKB 键名
    // 要查找特定键的 XKB 名称，可使用 wev 等程序
    //
    // "Mod" 是一个特殊修饰符，在 TTY 上运行时等于 Super，作为 winit 窗口运行时等于 Alt
    //
    // 此处可绑定的大多数操作也可以通过 `niri msg action do-something` 以编程方式调用

    // Mod-Shift-/，通常与 Mod-? 相同，显示重要快捷键列表
    Mod+Shift+Slash { show-hotkey-overlay; }

    // 运行程序的建议绑定：终端、应用程序启动器、屏幕锁定器
    // 终端模拟器配置
    Mod+T hotkey-overlay-title="终端模拟器 ghostty" { spawn "ghostty"; }
    Ctrl+Alt+T hotkey-overlay-title="终端模拟器 alacritty" { spawn "alacritty"; }

    // 程序启动器配置
    Mod+D hotkey-overlay-title="程序启动器" { spawn "fuzzel"; }
    Alt+Space hotkey-overlay-title="程序启动器" { spawn "fuzzel"; }

    // 输入法配置
    Mod+Space hotkey-overlay-title="打开或杀死输入法 fcitx5" { spawn-sh "pkill fcitx5 || fcitx5"; }

    // 文件管理器配置
    Mod+E hotkey-overlay-title="文件管理器" { spawn "Thunar"; }

    // 锁屏配置
    Super+Alt+L hotkey-overlay-title="锁屏" { spawn "~/.config/niri/scripts/swaylock.sh"; }

    // 使用 spawn-sh 运行 shell 命令。如果需要管道、多个命令等，请使用此方式
    // 注意：整个命令作为单个参数传递。它按原样传递给 `sh -c`
    // 例如，这是切换屏幕阅读器 (orca) 的标准绑定
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // PipeWire 与 WirePlumber 的音量键映射示例。
    // allow-when-locked=true 属性使得这些快捷键在会话锁定时依然有效。
    // 使用 spawn-sh 可以传递多个参数给命令。
    // "-l 1.0" 将音量上限限制在 100%。
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 使用 playerctl 的媒体键映射示例。
    // 这将适用于任何支持 MPRIS 的媒体播放器。
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // brightnessctl 的屏幕亮度键映射示例。
    // 你也可以使用常规的 spawn 并传递多个参数（以避免通过 "sh" 执行），
    // 但你需要手动将每个参数放在单独的引号 "" 中。
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // 打开/关闭概览：一个工作区和窗口的缩略视图。
    // 也可以将鼠标移动到左上角的热点区域，
    // 或者在触摸板上进行四指向上滑动。
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    // 窗口焦点切换
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // 当到达列中的第一个或最后一个窗口时，跨工作区移动的替代命令。
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+0 { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+0  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+0 { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    Mod+Ctrl+Shift+0  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // 或者，也有只移动单个窗口的命令：
    // Mod+Shift+Ctrl+Left  { move-windw-to-monitor-left; }
    // ...

    // 你也可以将整个工作区移动到另一个显示器：
    // Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    // ...

    Mod+Page_Down      { focus-workspace-down; }
    Mod+N              { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+P              { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+N         { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+P         { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // 或者，也有只移动单个窗口的命令：
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+N         { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+P         { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // 你可以使用以下语法绑定鼠标滚轮滚动事件。
    // 这些绑定会根据自然滚动设置改变方向。
    //
    // 为了避免滚轮滚动过快切换工作区，你可以使用
    // cooldown-ms 属性。该绑定将被限制为此值设定的速率。
    // 你可以在任何绑定上设置冷却时间，但对于滚轮来说最有用。
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // 通常在应用程序中按住 Shift 键进行上下滚动会导致
    // 水平滚动；这些绑定模拟了该行为。
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // 类似地，你可以绑定触摸板滚动的“刻度”。
    // 触摸板滚动是连续的，因此对于这些绑定，它被分割成
    // 离散的间隔。
    // 这些绑定也受触摸板自然滚动设置的影响，所以这些
    // 示例绑定是“反转的”，因为我们默认对触摸板启用了自然滚动。
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }
    
    // 你可以通过索引引用工作区。但是，请注意
    // niri 是一个动态工作区系统，所以这些命令在某种程度上是
    // “尽力而为”。尝试引用大于当前工作区数量的索引
    // 将转而引用最底部（空）的工作区。
    //
    // 例如，有 2 个工作区 + 1 个空工作区时，索引 3、4、5 等
    // 都将引用第 3 个工作区。
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // 或者，也有只移动单个窗口的命令：
    // Mod+Ctrl+1 { move-window-to-workspace 1; }
    
    // 在当前工作区和上一个工作区之间切换焦点。
    // Mod+Tab { focus-workspace-previous; }
    
    // 以下绑定将焦点窗口移入或移出列。
    // 如果窗口是独立的，它们会将其吸收到侧边的相邻列中。
    // 如果窗口已经在某个列中，它们会将其从列中排出。
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // 从右侧吸收一个窗口到焦点列的底部。
    Mod+BracketLeft  { consume-window-into-column; }
    Mod+Shift+Comma  { consume-window-into-column; }

    // 将焦点列底部的窗口排出到右侧。
    Mod+BracketRight { expel-window-from-column; }
    Mod+Shift+Period { expel-window-from-column; }

    // 也可以按相反顺序循环预设。
    Mod+Backslash { switch-preset-column-width; }
    Mod+Shift+Backslash { switch-preset-column-width-back; }

    Mod+R { switch-preset-window-height; }
    Mod+Shift+R { switch-preset-window-height-back; }

    Mod+F { maximize-column; }
    Mod+Shift+F { reset-window-height; }
    Mod+Ctrl+Shift+F { fullscreen-window; }

    // 将焦点列扩展到未被其他完全可见列占据的空间。
    // 使该列“填充剩余空间”。
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // 在屏幕上居中所有完全可见的列。
    Mod+Ctrl+C { center-visible-columns; }

    // 更精细的宽度调整。
    // 此命令还可以：
    // * 以像素为单位设置宽度："1000"
    // * 以像素为单位调整宽度："-5" 或 "+5"
    // * 以屏幕宽度的百分比设置宽度："25%"
    // * 以屏幕宽度的百分比调整宽度："-10%" 或 "+10%"
    // 像素大小使用逻辑像素或缩放像素。例如，在缩放比例为 2.0 的输出上，
    // set-column-width "100" 将使该列占据 200 个物理屏幕像素。
    Mod+Minus { set-column-width "-3%"; }
    Mod+Equal { set-column-width "+3%"; }

    // 当处于包含其他窗口的列中时，进行更精细的高度调整。
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 在浮动布局和平铺布局之间移动焦点窗口。
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // 切换列标签页显示模式。
    // 此列中的窗口将显示为垂直标签页，
    // 而不是堆叠在彼此之上。
    Mod+W { toggle-column-tabbed-display; }

    // 切换布局的操作。
    // 注意：如果你取消注释这些行，请确保你**没有**在
    // 上面的 xkb 选项中配置匹配的布局切换快捷键。
    // 在同一快捷键上同时设置两者会破坏切换功能，
    // 因为按下快捷键时会切换两次（一次由 xkb 触发，一次由 niri 触发）。
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    // 选择区域截图
    Mod+S { screenshot; }
    // 截取整个屏幕
    Mod+Shift+S { screenshot-screen; }
    // 截取当前窗口
    Mod+Ctrl+S { screenshot-window; }

    // 开启/隐藏 状态栏
    Mod+B { spawn "killall" "-SIGUSR1" "waybar"; }

    // 打开壁纸管理器
    Mod+Ctrl+W { spawn "waypaper"; }

    // 打开蓝牙管理器
    Mod+Ctrl+B { spawn "overskride"; }

    // 打开网络管理器
    Mod+Ctrl+Shift+N { spawn "nm-connection-editor"; }

    // 打开音乐播放工具
    Mod+Ctrl+M { spawn "play-musics"; }

    // 刷新状态栏
    Mod+Ctrl+Shift+S { spawn-sh "pkill waybar || true && waybar"; }

    // 某些应用程序，如远程桌面客户端和软件 KVM 切换器，可能会
    // 请求 niri 停止处理此处定义的键盘快捷键，
    // 以便它们可以将按键原样转发到远程机器。
    // 绑定一个“逃生舱口”来切换抑制器是个好主意，
    // 这样有问题的应用程序就无法劫持你的会话。
    //
    // allow-inhibiting=false 属性也可以应用于其他绑定，
    // 这确保了 niri 始终处理它们，即使抑制器处于活动状态。
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // quit 操作将显示一个确认对话框，以避免意外退出。
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // 关闭显示器电源。要重新打开它们，请执行任何输入操作，
    // 例如移动鼠标或按下任何其他键。
    Mod+Ctrl+Shift+P { power-off-monitors; }
}
