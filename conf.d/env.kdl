// env.kdl
// 此处配置 niri 桌面环境中必要的环境变量
environment {
    // -- 系统/应用 语言配置 ---
    LC_MESSAGES "zh_CN.UTF-8"
    LANG "zh_CN.UTF-8"

    // --- Wayland 环境中运行 Electron 应用必要的环境变量 ---
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    ELECTRON_ENABLE_FEATURES "WaylandWindowDecorations"

    // --- fcitx5 配置 ---
    XMODIFIERS "@im=fcitx"

    // --- Qt ---
    QT_QPA_PLATFORMTHEME "qt6ct"

    // --- GTK ---
    // gtk 主题设置
    GTK_THEME "Nordic:dark"
    include "env.d/gtk.kdl"

    // --- 其他 ---
    // 默认终端模拟器配置
    TERMINAL "ghostty"
    //默认文本编辑器
    EDIT "nvim"
}
