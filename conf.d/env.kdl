// env.kdl
// 此处配置 niri 桌面环境中必要的环境变量
environment {
    // -- 系统/应用 语言配置 ---
    LC_MESSAGES "zh_CN.UTF-8"
    LANG "zh_CN.UTF-8"

    // --- fcitx5 配置 ---
    XMODIFIERS "@im=fcitx"

    // --- 其他 ---
    // 默认终端模拟器配置
    TERMINAL "ghostty"

    //默认文本编辑器
    EDIT "nvim"
    EDITOR "nvim"
    VISUAL "nvim"
}
