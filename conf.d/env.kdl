// env.kdl
// 此处配置 niri 桌面环境中必要的环境变量
environment {
    // 系统/应用 语言配置
    include "env.d/language.kdl"
    // Wayland 环境中运行 Electron 应用必要的环境变量
    include "env.d/electron.kdl"
    // fcitx5 配置
    include "env.d/fcitx5.kdl"
    // Qt
    include "env.d/qt.kdl"
    // GTK
    include "env.d/gtk.kdl"

    // --- 其他 ---

    // 默认终端模拟器配置
    TERMINAL "ghostty"
    //默认文本编辑器
    EDIT "nvim"

}
